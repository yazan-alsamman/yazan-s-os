# PEOS environment variables. Copy to `.env` and fill in values.
# Validated at startup by src/lib/config/env.ts — missing/invalid critical values abort startup.
# Never commit real values.

# ── Application ────────────────────────────────────────────────
# NODE_ENV is set by Next.js (dev → development, build/start → production). Do not set it here.
# Public base URL of the app (also used as the Better Auth base URL and trusted origin).
APP_URL=http://localhost:3100
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Database (PostgreSQL) ──────────────────────────────────────
# Matches docker-compose.yml local defaults.
DATABASE_URL=postgresql://peos:peos_local_dev@127.0.0.1:55432/peos
# Isolated database for integration/E2E tests (created by docker/postgres/init).
TEST_DATABASE_URL=postgresql://peos:peos_local_dev@127.0.0.1:55432/peos_test

# ── Redis (queues, cache) ──────────────────────────────────────
REDIS_URL=redis://127.0.0.1:56379

# ── Authentication (Better Auth) ───────────────────────────────
# REQUIRED. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Account creation is closed unless explicitly enabled. Enable once to create your
# account, then set back to false.
AUTH_ALLOW_SIGNUP=false
# Disables auth rate limits. Accepted only when APP_URL is a loopback host (used by local E2E).
# AUTH_RATE_LIMIT_DISABLED=false
# Optional GitHub OAuth sign-in (both or neither).
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# ── Object storage (S3-compatible; optional in Phase 0) ────────
# Leave empty to run without object storage (health reports "not_configured").
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Observability (OpenTelemetry; optional) ────────────────────
OTEL_SERVICE_NAME=peos
# Exporter is deferred (ADR 0008). Reserved for when an OTLP collector is chosen.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── AI Copilot provider (Phase 8, ADR 0047; server-only) ───────
# "none" = retrieval-only mode (cited records, no synthesis). "openai_compatible" calls a
# Chat Completions-compatible endpoint (hosted or local) — AI_BASE_URL + AI_MODEL required.
AI_PROVIDER=none
# AI_BASE_URL=https://api.example.com/v1
# AI_MODEL=
# AI_API_KEY=
# AI_TIMEOUT_MS=30000

# ── Integration platform (Phase 9.5; server-only) ──────────────
# Base64-encoded 32-byte key for AES-256-GCM encryption of provider tokens at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required once any OAuth connector below is configured; without it, connecting fails safely.
INTEGRATION_ENCRYPTION_KEY=
# GitHub integration OAuth app (separate from AUTH_GITHUB_* sign-in). Scopes: read:user, repo.
# Callback: <APP_URL>/api/v1/integrations/callback/github
GITHUB_INTEGRATION_CLIENT_ID=
GITHUB_INTEGRATION_CLIENT_SECRET=
GITHUB_INTEGRATION_REDIRECT_URI=
# Google OAuth (Gmail/Drive/Calendar connectors — scaffolded, deferred). Needs a verified consent
# screen for Gmail scopes. Callback: <APP_URL>/api/v1/integrations/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
