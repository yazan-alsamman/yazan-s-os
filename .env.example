# PEOS environment variables. Copy to `.env` and fill in values.
# Validated at startup by src/lib/config/env.ts — missing/invalid critical values abort startup.
# Never commit real values.

# ── Application ────────────────────────────────────────────────
# NODE_ENV is set by Next.js (dev → development, build/start → production). Do not set it here.
# Public base URL of the app (also used as the Better Auth base URL and trusted origin).
APP_URL=http://localhost:3100
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Database (PostgreSQL) ──────────────────────────────────────
# Matches docker-compose.yml local defaults.
DATABASE_URL=postgresql://peos:peos_local_dev@127.0.0.1:55432/peos
# Isolated database for integration/E2E tests (created by docker/postgres/init).
TEST_DATABASE_URL=postgresql://peos:peos_local_dev@127.0.0.1:55432/peos_test

# ── Redis (queues, cache) ──────────────────────────────────────
REDIS_URL=redis://127.0.0.1:56379

# ── Authentication (Better Auth) ───────────────────────────────
# REQUIRED. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Account creation is closed unless explicitly enabled. Enable once to create your
# account, then set back to false.
AUTH_ALLOW_SIGNUP=false
# Disables auth rate limits. Accepted only when APP_URL is a loopback host (used by local E2E).
# AUTH_RATE_LIMIT_DISABLED=false
# Optional GitHub OAuth sign-in (both or neither).
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# ── Object storage (S3-compatible; optional in Phase 0) ────────
# Leave empty to run without object storage (health reports "not_configured").
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Observability (OpenTelemetry; optional) ────────────────────
OTEL_SERVICE_NAME=peos
# Exporter is deferred (ADR 0008). Reserved for when an OTLP collector is chosen.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── AI provider (reserved for Phase 8; not read by Phase 0 code) ──
# AI_PROVIDER=
# AI_API_KEY=
