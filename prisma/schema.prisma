// ── AI Lab & Experimentation (00 §4, 01 §4, 04 AIExperiment/ExperimentMetric; Phase 6) ──────────

/// Experiment lifecycle (ADR 0037). Completion is NOT success — the owner's conclusion is a
/// separate `decision`. "abandoned" = stopped without a conclusion.
enum ExperimentStatus {
  planned
  active
  completed
  abandoned

  @@map("experiment_status")
}

/// The owner's interpretation of what the experiment showed (04 AIExperiment.decision; ADR 0037).
/// Distinct from lifecycle status and from run execution status; null = not yet decided.
enum ExperimentDecision {
  adopt
  reject
  inconclusive

  @@map("experiment_decision")
}

/// Execution status of one run/iteration (ADR 0037). Distinguishes a failed execution from a
/// run that completed but was inconclusive (that judgement lives in the experiment's decision).
enum ExperimentRunStatus {
  completed
  failed
  aborted

  @@map("experiment_run_status")
}

/// An AI/ML experiment: the registry entry (04 AIExperiment; 01 §4). Hypothesis, objective and the
/// owner's decision live here; model/config/measurements live on its runs (ADR 0037). PEOS records
/// experiments — it does not execute them, so every measurement is a user-recorded fact (ADR 0040).
model AIExperiment {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  /// 04: Project 1:N AIExperiment. Optional — a lab experiment need not belong to a project.
  projectId           String?             @map("project_id") @db.Uuid
  title               String
  hypothesis          String?
  objective           String?
  /// Free-text experiment category/type (e.g. "RAG", "fine-tuning"); no closed taxonomy (ADR 0036).
  category            String?
  status              ExperimentStatus    @default(planned)
  /// Owner's conclusion (04 AIExperiment.decision); null = undecided. Never derived from status.
  decision            ExperimentDecision?
  /// 04 AIExperiment.result — narrative conclusion entered by the owner.
  result              String?
  /// 01 §4 "Reproducibility notes".
  reproducibilityNote String?             @map("reproducibility_note")
  startedAt           DateTime?           @map("started_at") @db.Date
  completedAt         DateTime?           @map("completed_at") @db.Date
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?             @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  runs     ExperimentRun[]
  evidence ExperimentEvidence[]

  @@unique([id, userId])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([projectId])
  @@map("ai_experiments")
}

/// One run/iteration of an experiment (ADR 0037). First-class and append-only: never overwritten,
/// so history is preserved. Holds the configuration that varies across runs (04's model /
/// modelVersion / promptVersion / dataset) and the measured cost, latency and tokens. All measured
/// values are recorded facts; a null means "not recorded", never zero (ADR 0040).
model ExperimentRun {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  experimentId   String              @map("experiment_id") @db.Uuid
  /// Sequential per experiment (1, 2, 3 …) for stable labels and ordering.
  runNumber      Int                 @map("run_number")
  label          String?
  status         ExperimentRunStatus @default(completed)
  /// Reproducibility metadata (ADR 0039) — recorded, not verified.
  model          String?
  modelVersion   String?             @map("model_version")
  provider       String?
  promptVersion  String?             @map("prompt_version")
  datasetName    String?             @map("dataset_name")
  datasetVersion String?             @map("dataset_version")
  codeRef        String?             @map("code_ref")
  environment    String?
  runAt          DateTime?           @map("run_at") @db.Date
  /// Measured engineering facts (04/05 cost & latency; token usage). Units: USD, ms, tokens.
  costUsd        Float?              @map("cost_usd")
  latencyMs      Float?              @map("latency_ms")
  tokensInput    Int?                @map("tokens_input")
  tokensOutput   Int?                @map("tokens_output")
  notes          String?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiment AIExperiment       @relation(fields: [experimentId, userId], references: [id, userId], onDelete: Cascade)
  metrics    ExperimentMetric[]

  @@unique([id, userId])
  @@unique([experimentId, runNumber])
  @@index([experimentId])
  @@index([userId])
  @@map("experiment_runs")
}

/// A recorded evaluation result for one run (04 ExperimentMetric). Per-criterion, with a unit and
/// an optional direction — never an opaque single "AI score" (ADR 0038). Attached to a run so runs
/// compare by metric deltas (01 §4). `value` is a recorded fact.
model ExperimentMetric {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  /// 04 ExperimentMetric.name — the criterion (e.g. "accuracy", "groundedness", "human rating").
  name           String
  value          Float
  unit           String?
  /// 04 ExperimentMetric.higherIsBetter; null = no direction (informational only).
  higherIsBetter Boolean? @map("higher_is_better")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  run  ExperimentRun @relation(fields: [runId, userId], references: [id, userId], onDelete: Cascade)

  @@index([runId])
  @@map("experiment_metrics")
}

/// Experiment ↔ Evidence (evidence-first provenance, 00 §5). Reuses the existing Evidence domain
/// rather than a new evidence concept (ADR 0038).
model ExperimentEvidence {
  userId       String   @map("user_id") @db.Uuid
  experimentId String   @map("experiment_id") @db.Uuid
  evidenceId   String   @map("evidence_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiment AIExperiment @relation(fields: [experimentId, userId], references: [id, userId], onDelete: Cascade)
  evidence   Evidence     @relation(fields: [evidenceId, userId], references: [id, userId], onDelete: Cascade)

  @@id([experimentId, evidenceId])
  @@index([evidenceId])
  @@map("experiment_evidence")
}

// ── Architecture Intelligence (01 §5, 04 ArchitectureDecision/Alternative, 08 Phase 7) ──────

/// ADR lifecycle (ADR 0042). Superseded and deprecated decisions stay as history; nothing is
/// deleted by a transition.
enum DecisionStatus {
  proposed
  accepted
  rejected
  deprecated
  superseded

  @@map("decision_status")
}

/// Architecture map node types — exactly the list in 01 §5 "Architecture Map" (ADR 0043).
enum ComponentType {
  service
  database
  queue
  external_api
  ai_model
  infrastructure

  @@map("component_type")
}

/// An architecture decision record (04 ArchitectureDecision + 01 §5 ADR Registry; ADR 0041).
/// Documented by the owner — PEOS never generates or infers decisions.
model ArchitectureDecision {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  title          String
  context        String?
  problem        String?
  /// 01 §5 "Constraints".
  constraints    String?
  decision       String?
  consequences   String?
  status         DecisionStatus @default(proposed)
  /// When the decision was made (accepted/rejected). Required for every status except proposed.
  decidedAt      DateTime?      @map("decided_at") @db.Date
  /// 04 revisitDate — when the decision should be reviewed; drives "revisit due" (ADR 0044).
  revisitDate    DateTime?      @map("revisit_date") @db.Date
  /// The decision that replaced this one; required while status = superseded (ADR 0042).
  supersededById String?        @map("superseded_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  supersededBy ArchitectureDecision?          @relation("DecisionSupersession", fields: [supersededById, userId], references: [id, userId], onDelete: NoAction)
  supersedes   ArchitectureDecision[]         @relation("DecisionSupersession")
  projects     DecisionProject[]
  alternatives ArchitectureAlternative[]
  evidence     ArchitectureDecisionEvidence[]
  components   DecisionComponent[]

  @@unique([id, userId])
  @@index([userId, status])
  @@index([userId, decidedAt])
  @@index([supersededById])
  @@map("architecture_decisions")
}

/// An option considered for a decision (04 ArchitectureAlternative; 01 "Options").
model ArchitectureAlternative {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  decisionId     String   @map("decision_id") @db.Uuid
  name           String
  pros           String?
  cons           String?
  rejectedReason String?  @map("rejected_reason")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision ArchitectureDecision @relation(fields: [decisionId, userId], references: [id, userId], onDelete: Cascade)

  @@index([decisionId])
  @@map("architecture_alternatives")
}

/// Decision ↔ Evidence (00 §5 "Architecture Decision → Evidence"); reuses Evidence.
model ArchitectureDecisionEvidence {
  userId     String   @map("user_id") @db.Uuid
  decisionId String   @map("decision_id") @db.Uuid
  evidenceId String   @map("evidence_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision ArchitectureDecision @relation(fields: [decisionId, userId], references: [id, userId], onDelete: Cascade)
  evidence Evidence             @relation(fields: [evidenceId, userId], references: [id, userId], onDelete: Cascade)

  @@id([decisionId, evidenceId])
  @@index([evidenceId])
  @@map("architecture_decision_evidence")
}

/// A component of the architecture map / component registry (01 §5, 08; ADR 0043).
model ArchitectureComponent {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  name      String
  /// Normalised name for per-user uniqueness.
  key       String
  type      ComponentType
  /// 01 §5 node detail "purpose".
  purpose   String?
  /// 05 "critical components": set by the owner, never inferred.
  critical  Boolean       @default(false)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  technologies ComponentTechnology[]
  projects     ComponentProject[]
  dependsOn    ComponentDependency[] @relation("ComponentDependent")
  dependents   ComponentDependency[] @relation("ComponentDependency")
  decisions    DecisionComponent[]

  @@unique([id, userId])
  @@unique([userId, key])
  @@index([userId, type])
  @@map("architecture_components")
}

/// Decision ↔ Project (01 §5 "Related projects"; 04 Project 1:N ADR is the single-project case).
/// A link table so deleting a project removes only the link — decision history survives (ADR 0041).
model DecisionProject {
  userId     String   @map("user_id") @db.Uuid
  decisionId String   @map("decision_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision ArchitectureDecision @relation(fields: [decisionId, userId], references: [id, userId], onDelete: Cascade)
  project  Project              @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  @@id([decisionId, projectId])
  @@index([projectId])
  @@map("decision_projects")
}

/// Component ↔ Technology (01 §5 node detail "technology"; existing Technology records only).
/// A link table so deleting a technology removes only the link (Phase 1 deletion unchanged).
model ComponentTechnology {
  userId       String   @map("user_id") @db.Uuid
  componentId  String   @map("component_id") @db.Uuid
  technologyId String   @map("technology_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  component  ArchitectureComponent @relation(fields: [componentId, userId], references: [id, userId], onDelete: Cascade)
  technology Technology            @relation(fields: [technologyId, userId], references: [id, userId], onDelete: Cascade)

  @@id([componentId, technologyId])
  @@index([technologyId])
  @@map("component_technologies")
}

/// Component ↔ Project (01 §5 node detail "projects").
model ComponentProject {
  userId      String   @map("user_id") @db.Uuid
  componentId String   @map("component_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  component ArchitectureComponent @relation(fields: [componentId, userId], references: [id, userId], onDelete: Cascade)
  project   Project               @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  @@id([componentId, projectId])
  @@index([projectId])
  @@map("component_projects")
}

/// "component depends on component" (08 dependency visualization; 05 Architecture Network).
model ComponentDependency {
  userId               String   @map("user_id") @db.Uuid
  componentId          String   @map("component_id") @db.Uuid
  dependsOnComponentId String   @map("depends_on_component_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  component ArchitectureComponent @relation("ComponentDependent", fields: [componentId, userId], references: [id, userId], onDelete: Cascade)
  dependsOn ArchitectureComponent @relation("ComponentDependency", fields: [dependsOnComponentId, userId], references: [id, userId], onDelete: Cascade)

  @@id([componentId, dependsOnComponentId])
  @@index([dependsOnComponentId])
  @@map("component_dependencies")
}

/// Decision ↔ Component (01 §5 node detail "decisions").
model DecisionComponent {
  userId      String   @map("user_id") @db.Uuid
  decisionId  String   @map("decision_id") @db.Uuid
  componentId String   @map("component_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision  ArchitectureDecision  @relation(fields: [decisionId, userId], references: [id, userId], onDelete: Cascade)
  component ArchitectureComponent @relation(fields: [componentId, userId], references: [id, userId], onDelete: Cascade)

  @@id([decisionId, componentId])
  @@index([componentId])
  @@map("decision_components")
}

// ── AI Copilot (06_AI_COPILOT.md, 08 Phase 8; ADRs 0046–0050) ───────────────

enum CopilotRole {
  user
  assistant

  @@map("copilot_role")
}

/// How an assistant answer was produced (ADR 0047): synthesized by the configured model and
/// validated, or assembled deterministically from tool results when no model is available.
enum CopilotAnswerMode {
  synthesis
  retrieval_only

  @@map("copilot_answer_mode")
}

enum CopilotToolStatus {
  ok
  rejected
  failed

  @@map("copilot_tool_status")
}

/// A Copilot conversation (06 "follow-up questions"; ADR 0049). Owner-scoped; deleting it deletes
/// its messages and tool-call log.
model CopilotConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CopilotMessage[]

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@map("copilot_conversations")
}

/// One turn. User messages store the question text; assistant messages store the validated
/// structured answer (statements + citations) — never the system prompt or raw provider output.
model CopilotMessage {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  conversationId String             @map("conversation_id") @db.Uuid
  role           CopilotRole
  /// User question (role = user).
  content        String?
  /// Validated structured answer (role = assistant), ADR 0048.
  answer         Json?
  mode           CopilotAnswerMode?
  /// Provider metadata — recorded only when the provider returned it; null = not reported (never 0).
  provider       String?
  model          String?
  inputTokens    Int?               @map("input_tokens")
  outputTokens   Int?               @map("output_tokens")
  latencyMs      Int?               @map("latency_ms")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation CopilotConversation @relation(fields: [conversationId, userId], references: [id, userId], onDelete: Cascade)
  toolCalls    CopilotToolCall[]

  @@unique([id, userId])
  @@index([conversationId, createdAt])
  @@map("copilot_messages")
}

/// Audit trail of tool calls (06 "log AI tool calls"; 10 "Audit trail for tool calls"; ADR 0046).
/// Inputs are the validated, owner-free arguments; results are summarized (count, sources), not
/// stored in full.
model CopilotToolCall {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  messageId   String            @map("message_id") @db.Uuid
  tool        String
  input       Json
  status      CopilotToolStatus
  resultCount Int?              @map("result_count")
  durationMs  Int               @map("duration_ms")
  error       String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  message CopilotMessage @relation(fields: [messageId, userId], references: [id, userId], onDelete: Cascade)

  @@index([messageId])
  @@index([userId, createdAt])
  @@map("copilot_tool_calls")
}

// ── Import review queue (00 §9, 11_DATA_IMPORT_PROFILE.md, ADR 0014) ─────────

enum ImportSource {
  peos_json
  csv
  linkedin_csv

  @@map("import_source")
}

/// Malformed files are rejected at upload (HTTP 400) and never create a job.
enum ImportJobStatus {
  pending_review
  completed

  @@map("import_job_status")
}

enum ImportEntityType {
  profile
  experience
  education
  skill
  technology
  certification
  project
  evidence

  @@map("import_entity_type")
}

enum ImportValidationStatus {
  valid
  invalid

  @@map("import_validation_status")
}

enum ImportMatch {
  new
  duplicate

  @@map("import_match")
}

enum ImportReviewStatus {
  pending
  accepted
  rejected

  @@map("import_review_status")
}

enum ImportDecision {
  create
  update

  @@map("import_decision")
}

enum ImportConfidence {
  high
  medium
  low

  @@map("import_confidence")
}

/// One uploaded source file. Source file contents are NOT stored — only metadata and the
/// normalised candidate records derived from it.
model ImportJob {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  source        ImportSource
  fileName      String            @map("file_name")
  fileSize      Int               @map("file_size")
  fileSha256    String            @map("file_sha256")
  parserVersion String            @map("parser_version")
  status        ImportJobStatus   @default(pending_review)
  entityHint    ImportEntityType? @map("entity_hint")
  recordCount   Int               @default(0) @map("record_count")
  invalidCount  Int               @default(0) @map("invalid_count")
  errorMessage  String?           @map("error_message")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt   DateTime?         @map("completed_at") @db.Timestamptz(3)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  records ImportRecord[]

  @@unique([id, userId])
  @@index([userId, createdAt])
  @@map("import_jobs")
}

/// A normalised candidate awaiting review. `payload` holds the normalised (never raw) candidate,
/// re-validated against the entity schema at decision time.
model ImportRecord {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  jobId            String                 @map("job_id") @db.Uuid
  entityType       ImportEntityType       @map("entity_type")
  /// Location in the source, e.g. "row 4" or "projects[2]".
  sourceRef        String                 @map("source_ref")
  payload          Json
  validationStatus ImportValidationStatus @map("validation_status")
  validationErrors Json?                  @map("validation_errors")
  confidence       ImportConfidence
  match            ImportMatch            @default(new)
  matchedEntityId  String?                @map("matched_entity_id") @db.Uuid
  reviewStatus     ImportReviewStatus     @default(pending) @map("review_status")
  decision         ImportDecision?
  resultEntityId   String?                @map("result_entity_id") @db.Uuid
  reviewedAt       DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  reviewedById     String?                @map("reviewed_by_id") @db.Uuid
  errorMessage     String?                @map("error_message")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  job        ImportJob @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)
  reviewedBy User?     @relation("ImportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  profiles       Profile[]       @relation("ProfileImport")
  experiences    Experience[]    @relation("ExperienceImport")
  education      Education[]     @relation("EducationImport")
  skills         Skill[]         @relation("SkillImport")
  technologies   Technology[]    @relation("TechnologyImport")
  certifications Certification[] @relation("CertificationImport")
  projects       Project[]       @relation("ProjectImport")
  evidence       Evidence[]      @relation("EvidenceImport")

  @@unique([id, userId])
  @@index([jobId, reviewStatus])
  @@index([userId, reviewStatus])
  @@map("import_records")
}
