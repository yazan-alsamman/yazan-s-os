// PEOS schema.
// Phase 0: identity, sessions, audit. Phase 1: core data platform (profile, career records,
// skills, technologies, certifications, projects, evidence, relationships, import review queue).
//
// Ownership invariant (ADR 0003, ADR 0011): every user-owned table carries a non-null `userId`.
// Join tables reference BOTH parents through composite FKs (id, user_id), so PostgreSQL itself
// rejects relationships that cross user boundaries.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Authenticated person. Fields required by Better Auth plus spec 04 (timezone, locale).
model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  name          String
  image         String?
  timezone      String   @default("UTC")
  locale        String   @default("en")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions  Session[]
  accounts  Account[]
  auditLogs AuditLog[]

  profile                      Profile?
  experiences                  Experience[]
  education                    Education[]
  skills                       Skill[]
  technologies                 Technology[]
  certifications               Certification[]
  projects                     Project[]
  milestones                   Milestone[]
  skillLevelModels             SkillLevelModel[]
  goals                        Goal[]
  goalProjects                 GoalProject[]
  goalSkills                   GoalSkill[]
  goalDependencies             GoalDependency[]
  goalMeasurements             GoalMeasurement[]
  technologySkills             TechnologySkill[]
  evidence                     Evidence[]
  aiExperiments                AIExperiment[]
  experimentRuns               ExperimentRun[]
  experimentMetrics            ExperimentMetric[]
  experimentEvidence           ExperimentEvidence[]
  architectureDecisions        ArchitectureDecision[]
  architectureAlternatives     ArchitectureAlternative[]
  architectureDecisionEvidence ArchitectureDecisionEvidence[]
  architectureComponents       ArchitectureComponent[]
  componentProjects            ComponentProject[]
  componentDependencies        ComponentDependency[]
  decisionComponents           DecisionComponent[]
  decisionProjects             DecisionProject[]
  copilotConversations         CopilotConversation[]
  copilotMessages              CopilotMessage[]
  copilotToolCalls             CopilotToolCall[]
  componentTechnologies        ComponentTechnology[]
  importJobs                   ImportJob[]
  reviewedImports              ImportRecord[]                 @relation("ImportReviewer")

  @@map("users")
}

/// Server-side session; the cookie only carries the signed token.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Credential or OAuth link managed by Better Auth. `password` holds a library-generated hash only.
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Short-lived verification values (email verification, password reset).
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Append-only audit trail for sensitive actions (spec 04 "Audit", 07 "Privacy").
/// Never store secrets in `before`/`after`.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ═════════════════════════════════════════════════════════════════════════════
// Phase 1 — Core Data Platform
// ═════════════════════════════════════════════════════════════════════════════

/// How a record entered PEOS. Imported records also link to the ImportRecord that produced them.
enum RecordOrigin {
  manual
  import

  @@map("record_origin")
}

/// Project lifecycle (01_FEATURE_CATALOG.md §3).
enum ProjectStatus {
  idea
  discovery
  architecture
  development
  validation
  production
  maintenance
  archived

  @@map("project_status")
}

/// The user's manual health assessment. Kept independent of the computed health signal (ADR 0023).
enum ProjectHealth {
  not_assessed
  on_track
  at_risk
  blocked

  @@map("project_health")
}

/// Milestone lifecycle (ADR 0022). completed ⇔ completed_at IS NOT NULL (check constraint).
enum MilestoneStatus {
  planned
  in_progress
  blocked
  completed
  cancelled

  @@map("milestone_status")
}

/// 01 §8 goal hierarchy levels (Milestone and Action are separate entities). ADR 0031.
enum GoalType {
  north_star
  annual_objective
  quarterly_goal

  @@map("goal_type")
}

/// Goal lifecycle (ADR 0031). completed ⇔ completed_at IS NOT NULL (check constraint).
enum GoalStatus {
  draft
  active
  on_hold
  completed
  cancelled

  @@map("goal_status")
}

/// 04 Goal.confidence — the user's own, manual confidence. Never derived (ADR 0033).
enum GoalConfidence {
  low
  medium
  high

  @@map("goal_confidence")
}

enum CertificationStatus {
  planned
  in_progress
  earned
  revoked

  @@map("certification_status")
}

/// Evidence categories from 01_FEATURE_CATALOG.md §10.
enum EvidenceType {
  certificate
  screenshot
  architecture_diagram
  repository
  demo
  production_metric
  document
  testimonial
  publication
  other

  @@map("evidence_type")
}

enum TechnologyUsageType {
  core
  supporting
  infrastructure
  tooling
  other

  @@map("technology_usage_type")
}

enum EvidenceStrength {
  weak
  moderate
  strong

  @@map("evidence_strength")
}

/// Profile — 1:1 with User. Name, timezone and locale live on User (spec 04 User).
model Profile {
  id                    String       @id @default(uuid()) @db.Uuid
  userId                String       @unique @map("user_id") @db.Uuid
  headline              String?
  summary               String?
  location              String?
  website               String?
  professionalObjective String?      @map("professional_objective")
  origin                RecordOrigin @default(manual)
  importRecordId        String?      @map("import_record_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  importRecord ImportRecord? @relation("ProfileImport", fields: [importRecordId], references: [id], onDelete: SetNull)

  @@index([importRecordId])
  @@map("profiles")
}

model Experience {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organization   String
  title          String
  startDate      DateTime     @map("start_date") @db.Date
  /// null = current position
  endDate        DateTime?    @map("end_date") @db.Date
  description    String?
  achievements   String[]     @default([])
  origin         RecordOrigin @default(manual)
  importRecordId String?      @map("import_record_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  importRecord ImportRecord?        @relation("ExperienceImport", fields: [importRecordId], references: [id], onDelete: SetNull)
  evidence     ExperienceEvidence[]

  @@unique([id, userId])
  @@index([userId, startDate])
  @@index([importRecordId])
  @@map("experiences")
}

/// Not defined in 04_DATA_MODEL.md; required by 00 §5 and 11 (ADR 0012).
model Education {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  institution    String
  degree         String?
  fieldOfStudy   String?      @map("field_of_study")
  startDate      DateTime?    @map("start_date") @db.Date
  endDate        DateTime?    @map("end_date") @db.Date
  description    String?
  achievements   String[]     @default([])
  origin         RecordOrigin @default(manual)
  importRecordId String?      @map("import_record_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  importRecord ImportRecord? @relation("EducationImport", fields: [importRecordId], references: [id], onDelete: SetNull)

  @@index([userId, startDate])
  @@index([importRecordId])
  @@map("education")
}

/// A user's skill. The current level is NOT stored: it is derived from evidence (00 §2.1, ADR 0013).
model Skill {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  name           String
  /// Normalised name for per-user uniqueness and import duplicate detection.
  key            String
  category       String?
  description    String?
  /// Level model identifier (ADR 0013): "peos-default-v1" (01 §6), or "custom" when
  /// levelModelId points to one of the owner's custom models (ADR 0026).
  levelModel     String       @default("peos-default-v1") @map("level_model")
  /// The owner's custom level model (labels/descriptions of the 0–5 scale), when levelModel = "custom".
  levelModelId   String?      @map("level_model_id") @db.Uuid
  targetLevel    Int?         @map("target_level")
  active         Boolean      @default(true)
  origin         RecordOrigin @default(manual)
  importRecordId String?      @map("import_record_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  importRecord     ImportRecord?        @relation("SkillImport", fields: [importRecordId], references: [id], onDelete: SetNull)
  projects         ProjectSkill[]
  evidence         SkillEvidence[]
  certifications   CertificationSkill[]
  technologies     TechnologySkill[]
  goals            GoalSkill[]
  customLevelModel SkillLevelModel?     @relation(fields: [levelModelId, userId], references: [id, userId], onDelete: NoAction)

  @@unique([id, userId])
  @@unique([userId, key])
  @@index([levelModelId])
  @@index([userId, category])
  @@index([importRecordId])
  @@map("skills")
}

model Technology {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  name           String
  key            String
  category       String?
  version        String?
  notes          String?
  origin         RecordOrigin @default(manual)
  importRecordId String?      @map("import_record_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  importRecord ImportRecord?         @relation("TechnologyImport", fields: [importRecordId], references: [id], onDelete: SetNull)
  usages       TechnologyUsage[]
  components   ComponentTechnology[]
  skills       TechnologySkill[]

  @@unique([id, userId])
  @@unique([userId, key])
  @@index([userId, category])
  @@index([importRecordId])
  @@map("technologies")
}

/// Certifications contribute evidence but never automatically prove a skill (01 §7).
model Certification {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  name            String
  issuer          String
  category        String?
  issueDate       DateTime?           @map("issue_date") @db.Date
  expiryDate      DateTime?           @map("expiry_date") @db.Date
  credentialId    String?             @map("credential_id")
  verificationUrl String?             @map("verification_url")
  status          CertificationStatus @default(earned)
  origin          RecordOrigin        @default(manual)
  importRecordId  String?             @map("import_record_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  importRecord ImportRecord?           @relation("CertificationImport", fields: [importRecordId], references: [id], onDelete: SetNull)
  skills       CertificationSkill[]
  evidence     CertificationEvidence[]

  @@unique([id, userId])
  @@index([userId, status])
  @@index([userId, expiryDate])
  @@index([importRecordId])
  @@map("certifications")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  name           String
  slug           String
  description    String?
  problem        String?
  solution       String?
  status         ProjectStatus @default(idea)
  healthStatus   ProjectHealth @default(not_assessed) @map("health_status")
  startDate      DateTime?     @map("start_date") @db.Date
  targetDate     DateTime?     @map("target_date") @db.Date
  completedAt    DateTime?     @map("completed_at") @db.Date
  impact         String?
  repositoryUrl  String?       @map("repository_url")
  demoUrl        String?       @map("demo_url")
  productionUrl  String?       @map("production_url")
  origin         RecordOrigin  @default(manual)
  importRecordId String?       @map("import_record_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  importRecord          ImportRecord?      @relation("ProjectImport", fields: [importRecordId], references: [id], onDelete: SetNull)
  skills                ProjectSkill[]
  technologies          TechnologyUsage[]
  evidence              ProjectEvidence[]
  milestones            Milestone[]
  goals                 GoalProject[]
  aiExperiments         AIExperiment[]
  architectureDecisions DecisionProject[]
  components            ComponentProject[]

  @@unique([id, userId])
  @@unique([userId, slug])
  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([importRecordId])
  @@map("projects")
}

model Evidence {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  type           EvidenceType
  title          String
  description    String?
  sourceUrl      String?      @map("source_url")
  fileUrl        String?      @map("file_url")
  date           DateTime?    @db.Date
  verified       Boolean      @default(false)
  verifiedAt     DateTime?    @map("verified_at") @db.Timestamptz(3)
  origin         RecordOrigin @default(manual)
  importRecordId String?      @map("import_record_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                  User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  importRecord          ImportRecord?                  @relation("EvidenceImport", fields: [importRecordId], references: [id], onDelete: SetNull)
  projects              ProjectEvidence[]
  skills                SkillEvidence[]
  certifications        CertificationEvidence[]
  experiences           ExperienceEvidence[]
  aiExperiments         ExperimentEvidence[]
  architectureDecisions ArchitectureDecisionEvidence[]

  @@unique([id, userId])
  @@index([userId, type])
  @@index([userId, date])
  @@index([importRecordId])
  @@map("evidence")
}

// ── Relationship tables (composite FKs enforce same-owner links) ─────────────

model ProjectSkill {
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId, userId], references: [id, userId], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
  @@map("project_skills")
}

/// Project N:M Technology (spec 04 TechnologyUsage).
/// A project milestone (spec 04 Milestone; ADR 0022). goalId is deferred to Goals (Phase 5).
/// Every milestone belongs to exactly one project of the same owner (composite FK).
model Milestone {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  /// 04 Milestone.goalId: the goal this milestone counts toward (Goal 1:N Milestone; ADR 0032).
  goalId      String?         @map("goal_id") @db.Uuid
  title       String
  /// Planned date (spec "dueDate"). Optional: undated milestones are never overdue.
  dueDate     DateTime?       @map("due_date") @db.Date
  completedAt DateTime?       @map("completed_at") @db.Date
  status      MilestoneStatus @default(planned)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  goal    Goal?   @relation(fields: [goalId, userId], references: [id, userId], onDelete: NoAction)

  @@unique([id, userId])
  @@index([goalId])
  @@index([projectId, dueDate])
  @@index([userId, status, dueDate])
  @@index([userId, completedAt])
  @@map("milestones")
}

/// A user's custom names and descriptions for the canonical 0–5 skill scale (ADR 0026).
/// levels = JSON array of exactly six {value 0..5, label, description}; validated in the service
/// and bounded by a CHECK constraint. Evidence-derivation rules stay per canonical value.
model SkillLevelModel {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  levels    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills Skill[]

  @@unique([id, userId])
  @@unique([userId, name])
  @@map("skill_level_models")
}

/// Technology ↔ Skill (00 §5, 01 §6 "Related technologies"; deferred by ADR 0017, built in Phase 4
/// — ADR 0030). Explicit, user-maintained; never inferred from projects.
model TechnologySkill {
  userId       String   @map("user_id") @db.Uuid
  technologyId String   @map("technology_id") @db.Uuid
  skillId      String   @map("skill_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId, userId], references: [id, userId], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId, userId], references: [id, userId], onDelete: Cascade)

  @@id([technologyId, skillId])
  @@index([skillId])
  @@map("technology_skills")
}

/// A goal (spec 04 Goal + 01 §8; ADR 0031). Hierarchy by type rank; progress is derived (ADR 0033).
model Goal {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  /// 04 Goal.parentId — same owner (composite FK); deletion refused while children exist.
  parentId    String?         @map("parent_id") @db.Uuid
  title       String
  type        GoalType
  description String?
  /// 01 §8 "Outcome": the result the goal is meant to produce.
  outcome     String?
  /// 04 Goal.metric: what is measured (e.g. "p95 latency"). With unit, baseline and target.
  metric      String?
  unit        String?
  baseline    Float?
  target      Float?
  /// Optional planned start (roadmap timeline); 04 defines only the deadline.
  startDate   DateTime?       @map("start_date") @db.Date
  /// 04 Goal.deadline — the target date (UTC calendar day).
  deadline    DateTime?       @db.Date
  status      GoalStatus      @default(draft)
  completedAt DateTime?       @map("completed_at") @db.Date
  confidence  GoalConfidence?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Goal?             @relation("GoalHierarchy", fields: [parentId, userId], references: [id, userId], onDelete: NoAction)
  children     Goal[]            @relation("GoalHierarchy")
  projects     GoalProject[]
  skills       GoalSkill[]
  dependsOn    GoalDependency[]  @relation("GoalDependent")
  dependents   GoalDependency[]  @relation("GoalDependency")
  measurements GoalMeasurement[]
  milestones   Milestone[]

  @@unique([id, userId])
  @@index([userId, status, deadline])
  @@index([parentId])
  @@map("goals")
}

/// Project N:M Goal (04 Relationships).
model GoalProject {
  userId    String   @map("user_id") @db.Uuid
  goalId    String   @map("goal_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal    Goal    @relation(fields: [goalId, userId], references: [id, userId], onDelete: Cascade)
  project Project @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  @@id([goalId, projectId])
  @@index([projectId])
  @@map("goal_projects")
}

/// Goal → Skills (00 §5). The skill's own target level applies (no per-goal level; ADR 0032).
model GoalSkill {
  userId    String   @map("user_id") @db.Uuid
  goalId    String   @map("goal_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal  Goal  @relation(fields: [goalId, userId], references: [id, userId], onDelete: Cascade)
  skill Skill @relation(fields: [skillId, userId], references: [id, userId], onDelete: Cascade)

  @@id([goalId, skillId])
  @@index([skillId])
  @@map("goal_skills")
}

/// 01 §8 "Dependencies" / 08 Phase 5: goal A depends on goal B. Acyclic (service-enforced).
model GoalDependency {
  userId          String   @map("user_id") @db.Uuid
  goalId          String   @map("goal_id") @db.Uuid
  dependsOnGoalId String   @map("depends_on_goal_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Goal @relation("GoalDependent", fields: [goalId, userId], references: [id, userId], onDelete: Cascade)
  dependsOn Goal @relation("GoalDependency", fields: [dependsOnGoalId, userId], references: [id, userId], onDelete: Cascade)

  @@id([goalId, dependsOnGoalId])
  @@index([dependsOnGoalId])
  @@map("goal_dependencies")
}

/// A recorded value of the goal's metric on a date (05 "Goal Burndown"; ADR 0033).
model GoalMeasurement {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  goalId    String   @map("goal_id") @db.Uuid
  date      DateTime @db.Date
  value     Float
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@index([goalId, date])
  @@map("goal_measurements")
}

model TechnologyUsage {
